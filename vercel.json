{
  "functions": {
    "api/scenes/[slug].js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/scenes/:slug",
      "destination": "/api/scenes/:slug"
    },
    {
      "source": "/((?!assets|src|node_modules|@).*)",
      "destination": "/index.html"
    }
  ]
}