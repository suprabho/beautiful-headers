{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/scenes/:slug",
      "destination": "/api/scenes/:slug"
    },
    {
      "source": "/scenes",
      "destination": "/api/scenes-index"
    },
    {
      "source": "/about",
      "destination": "/api/about"
    },
    {
      "source": "/embed/:slug",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
