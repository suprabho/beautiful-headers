{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/scenes/:slug",
      "destination": "/api/scenes/:slug"
    },
    {
      "source": "/scenes",
      "destination": "/index.html"
    },
    {
      "source": "/embed/:slug",
      "destination": "/index.html"
    }
  ]
}
