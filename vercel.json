{
  "functions": {
    "api/scenes/[slug]/capture.js": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/scenes/:slug/capture.png",
      "destination": "/api/scenes/:slug/capture"
    },
    {
      "source": "/scenes/:slug",
      "destination": "/api/scenes/:slug"
    },
    {
      "source": "/scenes",
      "destination": "/api/scenes-index"
    },
    {
      "source": "/about",
      "destination": "/api/about"
    },
    {
      "source": "/embed/:slug",
      "destination": "/embed.html"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
