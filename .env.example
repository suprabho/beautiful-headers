# CMS Configuration
PAYLOAD_SECRET=your-super-secret-key-change-this-in-production
CMS_PORT=3002

# Frontend Configuration (optional - defaults to localhost:3002)
VITE_CMS_URL=http://localhost:3002

# AI Integration (for auto-generating scene descriptions)
GEMINI_API_KEY=your-gemini-api-key-here

# Thumbnail CDN (optional — Cloudflare proxied domain for caching Supabase storage)
# Leave empty to serve directly from Supabase
VITE_THUMBNAIL_CDN_URL=https://thumbnails.promad.design
